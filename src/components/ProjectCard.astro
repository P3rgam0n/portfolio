---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang: 'en' | 'pl';
}
const { project, lang } = Astro.props;

const statusColors: Record<string, string> = {
  Production: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/25',
  Active:     'bg-blue-500/15 text-blue-400 border-blue-500/25',
  Commercial: 'bg-amber-500/15 text-amber-400 border-amber-500/25',
  PoC:        'bg-purple-500/15 text-purple-400 border-purple-500/25',
  Experiment: 'bg-rose-500/15 text-rose-400 border-rose-500/25',
};

const statusLabel: Record<string, { en: string; pl: string }> = {
  Production: { en: 'Production', pl: 'Produkcja' },
  Active:     { en: 'Active', pl: 'Aktywny' },
  Commercial: { en: 'Commercial', pl: 'Komercyjny' },
  PoC:        { en: 'Proof of Concept', pl: 'PoC' },
  Experiment: { en: 'Experiment', pl: 'Eksperyment' },
};
---

<article
  class:list={[
    'group relative flex flex-col rounded-2xl border border-white/[0.06] bg-[#16161f]',
    'hover:border-white/[0.12] card-glow overflow-hidden',
    project.featured ? 'ring-1 ring-inset ring-indigo-500/10' : '',
  ]}
>
  <!-- Gradient top strip -->
  <div class={`h-1 w-full bg-gradient-to-r ${project.gradient}`}></div>

  <div class="p-6 flex flex-col flex-1 gap-5">

    <!-- Header row -->
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl" role="img" aria-label={project.nameDisplay}>{project.icon}</span>
        <div>
          <h3 class="font-bold text-white text-base leading-tight group-hover:text-indigo-300 transition-colors">
            {project.nameDisplay}
          </h3>
          <p class="text-xs text-white/35 mt-0.5 font-mono">{project.name}</p>
        </div>
      </div>
      <div class="flex flex-col items-end gap-1.5 shrink-0">
        <!-- Status badge -->
        <span class:list={['px-2.5 py-0.5 rounded-full border text-xs font-semibold', statusColors[project.status]]}>
          {statusLabel[project.status]?.[lang] ?? project.status}
        </span>
        <!-- Public / Private -->
        <span class:list={[
          'px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wide',
          project.isPublic
            ? 'bg-green-500/10 text-green-400 border border-green-500/20'
            : 'bg-white/5 text-white/25 border border-white/8',
        ]}>
          {project.isPublic ? '⊕ Open Source' : '⊘ Private'}
        </span>
      </div>
    </div>

    <!-- Tagline -->
    <p class="text-sm text-white/50 font-medium italic leading-snug">
      {project.tagline[lang]}
    </p>

    <!-- Description -->
    <p class="text-sm text-white/40 leading-relaxed flex-1">
      {project.description[lang]}
    </p>

    <!-- Features -->
    <ul class="space-y-1.5">
      {project.features[lang].slice(0, 4).map(f => (
        <li class="flex items-start gap-2 text-xs text-white/45">
          <span class="mt-0.5 shrink-0 text-indigo-400/70">▸</span>
          {f}
        </li>
      ))}
    </ul>

    <!-- Tech tags -->
    <div class="flex flex-wrap gap-1.5 pt-1">
      {project.tech.slice(0, 6).map(t => (
        <span class="px-2 py-0.5 rounded-md bg-white/[0.04] border border-white/[0.06] text-white/35 text-[11px] font-mono">
          {t}
        </span>
      ))}
    </div>

    <!-- Footer link -->
    {project.repoUrl && (
      <div class="pt-1 border-t border-white/[0.05]">
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition-colors"
        >
          {lang === 'en' ? 'View on GitHub' : 'Zobacz na GitHub'}
          <svg width="12" height="12" fill="none" viewBox="0 0 12 12">
            <path d="M2 2h8M10 2v8M2 10l8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    )}
    {!project.repoUrl && !project.isPublic && (
      <div class="pt-1 border-t border-white/[0.05]">
        <span class="text-xs text-white/20 italic">
          {lang === 'en' ? 'Private repository — code not publicly available' : 'Prywatne repozytorium — kod niedostępny publicznie'}
        </span>
      </div>
    )}
  </div>
</article>
