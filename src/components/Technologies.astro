---
import { techStack } from '../data/projects';

interface Props { lang: 'en' | 'pl'; }
const { lang } = Astro.props;

const levelColors = {
  Expert:       'border-indigo-500/40 bg-indigo-500/8 text-indigo-300',
  Advanced:     'border-white/10 bg-white/[0.04] text-white/60',
  Intermediate: 'border-white/6 bg-white/[0.02] text-white/40',
} as const;

const levelLabel = {
  Expert:       { en: 'Expert', pl: 'Ekspert' },
  Advanced:     { en: 'Advanced', pl: 'Zaawansowany' },
  Intermediate: { en: 'Intermediate', pl: 'Średniozaawansowany' },
} as const;
---

<section id="technologies" class="py-28 px-6 border-t border-white/[0.04]">
  <div class="max-w-5xl mx-auto">
    <span class="text-indigo-400 text-xs font-bold tracking-widest uppercase mb-4 block">
      {lang === 'en' ? 'Stack' : 'Technologie'}
    </span>
    <h2 class="text-4xl md:text-5xl font-black text-white mb-4">
      {lang === 'en' ? 'Technologies & Tools' : 'Technologie i narzędzia'}
    </h2>
    <p class="text-white/40 text-base mb-14 max-w-xl leading-relaxed">
      {lang === 'en'
        ? 'Tools I use daily across projects — from AI infrastructure to frontend and system-level programming.'
        : 'Narzędzia używane codziennie — od infrastruktury AI po frontend i programowanie systemowe.'}
    </p>

    <!-- Expert first -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {techStack.map(t => (
        <div
          class:list={[
            'flex items-center gap-3 px-4 py-3 rounded-xl border transition-all hover:-translate-y-0.5',
            levelColors[t.level],
          ]}
        >
          <span class="text-xl shrink-0" role="img">{t.icon}</span>
          <div class="min-w-0">
            <div class="text-sm font-semibold truncate">{t.name}</div>
            <div class="text-[10px] opacity-50 font-medium">{levelLabel[t.level][lang]}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
