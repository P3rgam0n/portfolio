---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'pl';
}

const {
  title = 'Michał Jura — Portfolio',
  description = 'Portfolio of Michał Jura — 3D Graphics & Automation Specialist. Python, AI, Gemini, ComfyUI, Windows tools.',
  lang = 'en',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const ogImage = `${Astro.site}${base}/img/og.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-[#f0f0f5] overflow-x-hidden">
    <slot />
  </body>
</html>
