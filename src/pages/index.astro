---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Technologies from '../components/Technologies.astro';
import Experiments from '../components/Experiments.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const lang = 'en' as const;
---

<Layout
  title="Michał Jura — 3D Graphics & Automation Specialist"
  description="Portfolio of Michał Jura (P3rgam0n) — 3D Graphics & Automation Specialist. Python, Google Cloud AI, Gemini, ComfyUI, Amazon Bedrock, Windows tools."
  lang={lang}
>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <About lang={lang} />
    <Projects lang={lang} />
    <Technologies lang={lang} />
    <Experiments lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

